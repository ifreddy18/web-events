{
	"name": "web",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --webpack",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"typecheck": "tsc --noEmit",
		"test": "vitest run && node scripts/with-db-env.ts test vitest run --config vitest.integration.config.mts",
		"test:unit": "vitest run",
		"test:integration": "node scripts/with-db-env.ts test vitest run --config vitest.integration.config.mts",
		"test:e2e": "playwright test --pass-with-no-tests",
		"db:generate": "prisma generate",
		"db:migrate": "node scripts/with-db-env.ts dev prisma migrate dev",
		"db:migrate:test": "node scripts/with-db-env.ts test prisma migrate deploy",
		"db:studio": "node scripts/with-db-env.ts dev prisma studio",
		"auth:create-admin": "node scripts/with-db-env.ts dev node --conditions=react-server scripts/create-admin.ts",
		"db:seed": "echo 'db:seed is a placeholder: no seed implemented yet' && exit 1"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.4.0",
		"@prisma/client": "6",
		"@tanstack/react-table": "^8.21.3",
		"better-auth": "^1.7.8",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.1.0",
		"dotenv": "^18.0.7",
		"lucide-react": "^1.16.0",
		"next": "16.2.6",
		"radix-ui": "^1.4.3",
		"react": "19.2.6",
		"react-dom": "19.2.6",
		"react-hook-form": "^7.75.0",
		"server-only": "^0.0.1",
		"shadcn": "^4.8.2",
		"slugify": "^1.6.9",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "16.2.6",
		"prisma": "6",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vitest": "^5.0.4"
	},
	"engines": {
		"node": ">=22.18.0 <23"
	},
	"packageManager": "pnpm@10.34.7"
}
