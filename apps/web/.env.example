# Copy to .env (dev) and .env.test (tests). Never commit real values.
# Local Homebrew PostgreSQL 17. Add ":password" after the user if your server requires one.
DATABASE_URL="postgresql://<your-os-user>@localhost:5432/events_dev"
# .env.test:
# DATABASE_URL="postgresql://<your-os-user>@localhost:5432/events_test"
# Better Auth (required). Generate a distinct secret per environment: openssl rand -base64 32
BETTER_AUTH_SECRET="<random, at least 32 characters>"
# Public origin of the app (dev: http://localhost:3000; Playwright/.env.test: http://localhost:3100)
BETTER_AUTH_URL="http://localhost:3000"
